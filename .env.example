# =================================================================
# Конфигурация окружения для развертывания проекта в Docker Compose
# Скопируйте этот файл в .env и укажите свои параметры перед запуском
# =================================================================

# Настройки базы данных PostgreSQL
DB_NAME=music_platform
DB_USER=postgres
DB_PASSWORD=secure_postgres_password_2026

# Настройки секретного ключа для JWT аутентификации
JWT_SECRET=super_secure_jwt_secret_key_music_platform_2026

# Порты и адреса клиентской части
CLIENT_URL=http://localhost:3000
